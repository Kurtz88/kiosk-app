{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "env": {
    "KIOSK_UPLOADS_BASE_URL": "https://dgbukfood.co.kr/uploads",
    "KIOSK_USE_TMP_DB": "1",
    "KIOSK_INFO_REPORT_NOTIFY_EMAIL": "elysia0419@gmail.com",
    "KIOSK_SMTP_HOST": "smtp.gmail.com",
    "KIOSK_SMTP_PORT": "587"
  },
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
